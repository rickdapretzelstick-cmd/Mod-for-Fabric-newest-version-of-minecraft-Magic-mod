        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 3700000
        }
      },
      "continueOnFail": true
