      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8765/api/auto/ideas/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 3700000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "count",
              "value": "8"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "48fbaecc-5838-4d7f-aea5-44c7d492d8b3",
      "name": "Pick strongest (not duplicates, above min score)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        80
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json; const min = r.min_score;\nreturn r.ideas.filter(i => i.status === 'new' && i.score >= min).sort((a,b)=>b.score-a.score).slice(0,2).map(i => ({json:{idea_id:i.id, title:i.title, score:i.score}}));"
      }
    },
    {
      "id": "9e85a2c0-7e79-4f4f-a513-5bd97c6df0f6",
      "name": "Create project (script+storyboard queued)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8765/api/auto/projects",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 3700000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({idea_id: $json.idea_id}) }}"
      }
    },
    {
      "id": "615ff611-8ee1-449e-bedc-883fbfc7ea84",
